# Copie para .env e preencha. O projeto fala com qualquer API compatível com OpenAI.

# --- Opção A: Google Gemini (tem plano gratuito; crie a chave no Google AI Studio) ---
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=cole_sua_chave_aqui
LLM_MODEL=gemini-3.8-flash
# Nomes de modelo mudam com o tempo: se der erro 404, veja a lista atual no Google AI Studio.

# --- Opção B: Groq (tem plano gratuito) ---
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=cole_sua_chave_aqui
# LLM_MODEL=llama-3.3-70b-versatile

# --- Opção C: Ollama local (100% grátis, roda no seu PC; use um modelo com suporte a tools) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b

# Opcional
# PANEL_TOKEN=uma_senha_para_o_painel
# MAX_USER_MESSAGES=30
# RATE_LIMIT_PER_MINUTE=20

# --- Recomendado para a demo pública do portfólio ---
# Limite diário GLOBAL de mensagens (protege a sua cota; 0 = sem limite)
# DAILY_MESSAGE_LIMIT=150
# Links mostrados no chat quando a demo atinge o limite
# DEMO_VIDEO_URL=https://link-do-seu-video
# REPO_URL=https://github.com/seu-usuario/marcenaria-agent

# --- Modelo reserva (recomendado): entra sozinho se o principal der 503/429 ---
# Opção 1: outro modelo do Gemini, com a mesma chave (escolha um da lista do seu AI Studio)
# LLM_FALLBACK_MODEL=gemini-3.1-flash-lite
# Opção 2: outro provedor gratuito, como o Groq (precisa de uma chave dele)
# LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
# LLM_FALLBACK_API_KEY=cole_a_chave_do_groq
# LLM_FALLBACK_MODEL=llama-3.3-70b-versatile

# --- Velocidade ---
# Menos raciocínio = resposta mais rápida (Gemini). Se der erro 400 por causa disso, apague a linha.
# LLM_REASONING_EFFORT=low
# Espera máxima pelo modelo, em segundos (menor = troca para o reserva mais cedo)
# LLM_TIMEOUT=20

# Segundos que um modelo com problema passageiro (503, 429) fica em pausa; nesse tempo
# as mensagens vão direto para o reserva. 0 desliga.
# LLM_COOLDOWN=60
